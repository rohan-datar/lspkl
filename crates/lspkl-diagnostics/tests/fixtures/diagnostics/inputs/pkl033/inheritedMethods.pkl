import "pkl:ref"
abstract class Parent { abstract function required(): Int }
class Missing extends Parent {}
abstract class Deferred extends Parent {}
class Implemented extends Parent { function required(): Int = 1 }
class SdkMissing extends ref.AbstractDomain {}
class SdkImplemented extends ref.AbstractDomain {
  function renderReference(reference: ref.Reference<this, Any>): String = "ok"
}
